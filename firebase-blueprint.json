{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile in InfroPay",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Auth UID" },
        "name": { "type": "string", "description": "Full name or producer name" },
        "email": { "type": "string", "format": "email", "description": "User email address" },
        "photoURL": { "type": "string", "description": "User avatar image URL" },
        "role": { "type": "string", "enum": ["user", "seller", "admin"], "description": "User role" },
        "status": { "type": "string", "enum": ["active", "suspended", "banned"], "description": "Account status" },
        "createdAt": { "type": "string", "description": "ISO timestamp" },
        "updatedAt": { "type": "string", "description": "ISO timestamp" },
        "lastLoginAt": { "type": "string", "description": "ISO timestamp" }
      },
      "required": ["uid", "email", "role", "createdAt"]
    },
    "Wallet": {
      "title": "Wallet",
      "description": "User financial wallet balance and aggregate totals",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Auth UID" },
        "availableBalance": { "type": "number", "description": "Available balance in AOA" },
        "pendingBalance": { "type": "number", "description": "Pending balance in AOA" },
        "totalSales": { "type": "number", "description": "Gross total sales in AOA" },
        "totalWithdrawn": { "type": "number", "description": "Total net amount withdrawn in AOA" },
        "totalSaleFees": { "type": "number", "description": "Total 2% sale fees charged in AOA" },
        "totalWithdrawalFees": { "type": "number", "description": "Total 6% withdrawal fees charged in AOA" },
        "updatedAt": { "type": "string", "description": "ISO timestamp" }
      },
      "required": ["userId", "availableBalance", "pendingBalance", "totalSales", "totalWithdrawn"]
    },
    "Product": {
      "title": "Product",
      "description": "Digital product listed by a producer",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Product unique ID" },
        "sellerId": { "type": "string", "description": "Seller Auth UID" },
        "name": { "type": "string", "description": "Product title" },
        "description": { "type": "string", "description": "Product description" },
        "price": { "type": "number", "description": "Price in Angolan Kwanzas (AOA)" },
        "image": { "type": "string", "description": "Product cover image URL" },
        "status": { "type": "string", "enum": ["draft", "pending", "active", "archived", "rejected"], "description": "Publication status" },
        "createdAt": { "type": "string", "description": "ISO timestamp" },
        "updatedAt": { "type": "string", "description": "ISO timestamp" }
      },
      "required": ["id", "sellerId", "name", "price", "status", "createdAt"]
    },
    "Sale": {
      "title": "Sale",
      "description": "Sale record with strictly calculated 2% platform commission",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Sale transaction unique ID" },
        "sellerId": { "type": "string", "description": "Seller Auth UID" },
        "buyerId": { "type": "string", "description": "Buyer Auth UID if authenticated" },
        "buyerName": { "type": "string", "description": "Buyer full name" },
        "buyerEmail": { "type": "string", "format": "email", "description": "Buyer email" },
        "productId": { "type": "string", "description": "Purchased product unique ID" },
        "productName": { "type": "string", "description": "Snapshot of product title" },
        "grossAmount": { "type": "number", "description": "Gross sale amount in AOA" },
        "platformFeePercent": { "type": "number", "description": "Commission percent applied (2)" },
        "platformFeeAmount": { "type": "number", "description": "Commission fee amount in AOA (gross * 0.02)" },
        "sellerNetAmount": { "type": "number", "description": "Net amount credited to seller in AOA (gross - fee)" },
        "paymentMethod": { "type": "string", "description": "Payment gateway method used" },
        "status": { "type": "string", "enum": ["pending", "paid", "cancelled", "refunded"], "description": "Payment status" },
        "createdAt": { "type": "string", "description": "ISO timestamp" },
        "updatedAt": { "type": "string", "description": "ISO timestamp" }
      },
      "required": ["id", "sellerId", "productId", "grossAmount", "platformFeePercent", "platformFeeAmount", "sellerNetAmount", "status", "createdAt"]
    },
    "Withdrawal": {
      "title": "Withdrawal",
      "description": "Withdrawal request with strictly calculated 6% withdrawal fee",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Withdrawal unique ID" },
        "userId": { "type": "string", "description": "Producer Auth UID" },
        "requestedAmount": { "type": "number", "description": "Gross requested amount in AOA" },
        "withdrawalFeePercent": { "type": "number", "description": "Withdrawal fee percent applied (6)" },
        "withdrawalFeeAmount": { "type": "number", "description": "Withdrawal fee amount in AOA (requested * 0.06)" },
        "netAmount": { "type": "number", "description": "Net amount to transfer to producer in AOA (requested - fee)" },
        "method": { "type": "string", "description": "Withdrawal channel (e.g., bank_transfer)" },
        "accountDetails": { "type": "string", "description": "JSON or formatted bank details (IBAN, Holder, Bank)" },
        "status": { "type": "string", "enum": ["pending", "in_review", "approved", "paid", "rejected"], "description": "Withdrawal lifecycle status" },
        "idempotencyKey": { "type": "string", "description": "Unique key ensuring atomic, non-duplicate withdrawal" },
        "requestedAt": { "type": "string", "description": "ISO timestamp" },
        "processedAt": { "type": "string", "description": "ISO timestamp when processed" },
        "processedBy": { "type": "string", "description": "Admin UID who processed withdrawal" },
        "rejectionReason": { "type": "string", "description": "Reason given if rejected" }
      },
      "required": ["id", "userId", "requestedAmount", "withdrawalFeePercent", "withdrawalFeeAmount", "netAmount", "status", "requestedAt"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Unified ledger entry for all financial movements",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Transaction ID" },
        "userId": { "type": "string", "description": "User Auth UID" },
        "type": { "type": "string", "enum": ["sale", "commission", "withdrawal", "fee", "credit", "debit"], "description": "Transaction category" },
        "amount": { "type": "number", "description": "Gross amount in AOA" },
        "fee": { "type": "number", "description": "Fee amount in AOA" },
        "netAmount": { "type": "number", "description": "Net amount in AOA" },
        "referenceId": { "type": "string", "description": "Associated saleId or withdrawalId" },
        "status": { "type": "string", "enum": ["pending", "completed", "failed", "cancelled"], "description": "Transaction status" },
        "description": { "type": "string", "description": "Human readable description" },
        "createdAt": { "type": "string", "description": "ISO timestamp" }
      },
      "required": ["id", "userId", "type", "amount", "fee", "netAmount", "status", "createdAt"]
    },
    "PlatformSettings": {
      "title": "PlatformSettings",
      "description": "Global platform financial configuration",
      "type": "object",
      "properties": {
        "saleFeePercent": { "type": "number", "description": "Global commission percent per sale (2)" },
        "withdrawalFeePercent": { "type": "number", "description": "Global withdrawal fee percent (6)" },
        "currency": { "type": "string", "description": "Platform default currency (AOA)" },
        "minimumWithdrawal": { "type": "number", "description": "Minimum withdrawal amount in AOA (5000)" },
        "updatedAt": { "type": "string", "description": "ISO timestamp" }
      },
      "required": ["saleFeePercent", "withdrawalFeePercent", "currency", "minimumWithdrawal"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Immutable security and administrative action audit record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Log entry unique ID" },
        "adminId": { "type": "string", "description": "Admin Auth UID" },
        "adminName": { "type": "string", "description": "Admin display name" },
        "action": { "type": "string", "description": "Action performed" },
        "targetType": { "type": "string", "description": "Target entity type (user, product, withdrawal, system)" },
        "targetId": { "type": "string", "description": "Target entity identifier" },
        "details": { "type": "string", "description": "Serialized JSON action details" },
        "createdAt": { "type": "string", "description": "ISO timestamp" }
      },
      "required": ["id", "adminId", "action", "targetType", "targetId", "createdAt"]
    },
    "Notification": {
      "title": "Notification",
      "description": "In-app and push notification record for a user",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Notification unique ID" },
        "userId": { "type": "string", "description": "Recipient Auth UID" },
        "type": {
          "type": "string",
          "enum": [
            "sale_approved",
            "sale_created",
            "withdrawal_requested",
            "withdrawal_approved",
            "withdrawal_rejected",
            "withdrawal_processing",
            "product_approved",
            "product_rejected",
            "platform_update",
            "security_alert",
            "system_alert"
          ],
          "description": "Notification category"
        },
        "title": { "type": "string", "description": "Notification title" },
        "message": { "type": "string", "description": "Notification content/body" },
        "data": { "type": "string", "description": "Serialized JSON metadata" },
        "link": { "type": "string", "description": "Target redirection route" },
        "read": { "type": "boolean", "description": "Read status" },
        "readAt": { "type": "string", "description": "ISO timestamp when read" },
        "idempotencyKey": { "type": "string", "description": "Unique key to prevent duplicate notifications" },
        "createdAt": { "type": "string", "description": "ISO timestamp" }
      },
      "required": ["id", "userId", "type", "title", "message", "read", "createdAt"]
    },
    "FCMToken": {
      "title": "FCMToken",
      "description": "Web Push / Firebase Cloud Messaging token for device",
      "type": "object",
      "properties": {
        "token": { "type": "string", "description": "Device FCM registration token" },
        "userId": { "type": "string", "description": "Device owner Auth UID" },
        "platform": { "type": "string", "description": "Browser / OS platform" },
        "userAgent": { "type": "string", "description": "Client User-Agent" },
        "createdAt": { "type": "string", "description": "ISO timestamp" },
        "updatedAt": { "type": "string", "description": "ISO timestamp" }
      },
      "required": ["token", "userId", "createdAt"]
    },
    "NotificationPreferences": {
      "title": "NotificationPreferences",
      "description": "User notification channel preferences",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Auth UID" },
        "pushEnabled": { "type": "boolean", "description": "Push notifications toggle" },
        "emailSales": { "type": "boolean", "description": "Sale emails toggle" },
        "emailWithdrawals": { "type": "boolean", "description": "Withdrawal emails toggle" },
        "emailUpdates": { "type": "boolean", "description": "Platform updates emails toggle" },
        "securityAlerts": { "type": "boolean", "description": "Security alerts toggle (always true)" },
        "updatedAt": { "type": "string", "description": "ISO timestamp" }
      },
      "required": ["userId", "pushEnabled", "emailSales", "emailWithdrawals", "emailUpdates"]
    },
    "AdminBroadcast": {
      "title": "AdminBroadcast",
      "description": "Platform-wide broadcast announcement created by admin",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Broadcast unique ID" },
        "adminId": { "type": "string", "description": "Admin Auth UID" },
        "title": { "type": "string", "description": "Announcement title" },
        "message": { "type": "string", "description": "Announcement content" },
        "type": { "type": "string", "description": "Broadcast type" },
        "audience": { "type": "string", "enum": ["all", "sellers", "buyers", "specific"], "description": "Target audience" },
        "channels": { "type": "string", "description": "JSON array of channels (in_app, push, email)" },
        "sentCount": { "type": "number", "description": "Number of users reached" },
        "createdAt": { "type": "string", "description": "ISO timestamp" }
      },
      "required": ["id", "adminId", "title", "message", "audience", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profiles collection"
    },
    "/wallets/{userId}": {
      "schema": { "$ref": "#/entities/Wallet" },
      "description": "Producer wallet balances (server-authoritative)"
    },
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Digital products catalog"
    },
    "/sales/{saleId}": {
      "schema": { "$ref": "#/entities/Sale" },
      "description": "Sales records with 2% platform commission"
    },
    "/withdrawals/{withdrawalId}": {
      "schema": { "$ref": "#/entities/Withdrawal" },
      "description": "Withdrawal requests with 6% fee"
    },
    "/transactions/{transactionId}": {
      "schema": { "$ref": "#/entities/Transaction" },
      "description": "Unified financial ledger transactions"
    },
    "/platformSettings/main": {
      "schema": { "$ref": "#/entities/PlatformSettings" },
      "description": "Platform financial and commission configuration"
    },
    "/auditLogs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Security and administrative audit trail"
    },
    "/users/{userId}/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "User in-app notifications subcollection"
    },
    "/users/{userId}/fcm_tokens/{tokenId}": {
      "schema": { "$ref": "#/entities/FCMToken" },
      "description": "User registered FCM push tokens"
    },
    "/users/{userId}/preferences/notifications": {
      "schema": { "$ref": "#/entities/NotificationPreferences" },
      "description": "User notification channel preferences"
    },
    "/admin_broadcasts/{broadcastId}": {
      "schema": { "$ref": "#/entities/AdminBroadcast" },
      "description": "Platform broadcast announcements"
    }
  }
}
